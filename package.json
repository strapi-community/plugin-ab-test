{
  "name": "@strapi/plugin-ab-test",
  "version": "0.2.1",
  "description": "A/B testing for Strapi 5: keep variants of an entry and split Content API traffic between them. Works with i18n and Draft & Publish.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "ab-testing",
    "experiments",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strapi-community/plugin-ab-test.git"
  },
  "homepage": "https://github.com/strapi-community/plugin-ab-test#readme",
  "bugs": {
    "url": "https://github.com/strapi-community/plugin-ab-test/issues"
  },
  "author": "Maxime Castres <maxime.castres@protonmail.com>",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "prepublishOnly": "npm run build && npm run verify && npm test",
    "test": "vitest run",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "playground:sync": "node scripts/sync-playground.mjs",
    "translations": "node scripts/extract-translations.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.56.0",
    "@strapi/typescript-utils": "^5.56.0",
    "@strapi/utils": "^5.56.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.37.0",
    "@strapi/utils": "^5.37.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "ab-test",
    "displayName": "A/B Testing",
    "description": "Keep variants of an entry and split Content API traffic between them."
  }
}
